// Aditya International ERP — data model
// SQLite for local dev. For production, switch `provider` to "postgresql"
// and set DATABASE_URL to your hosted Postgres connection string.

generator client {
  provider      = "prisma-client-js"
  // "native" for local use; the rhel target is what Vercel's servers need.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The exporter's own details — a single row (id = "default") used as the
// letterhead on proforma invoices. All fields optional; the PDF shows what's set.
model CompanyProfile {
  id             String   @id @default("default")
  legalName      String?
  address        String? // multi-line billing/registered address
  gstin          String?
  phone          String?
  email          String?
  website        String?
  logoData       String? // downscaled logo as a base64 data URL
  // Footer
  signatureName  String? // "Authorised Signatory" name
  footerNote     String? // standing terms / thank-you line
  updatedAt      DateTime @updatedAt @default(now())
}

// One bank account per currency, so the proforma shows the account a buyer
// should actually pay into. INR uses IFSC; foreign accounts use SWIFT (and
// sometimes IBAN) — the PDF prints whichever fields are filled.
model BankAccount {
  id          String   @id @default(cuid())
  currency    String   @unique // USD, EUR, GBP, INR — one account each
  bankName    String?
  accountName String?
  accountNo   String?
  swift       String? // foreign-currency accounts
  ifsc        String? // INR (domestic) accounts
  iban        String? // some EUR / GBP accounts
  branch      String?
  bankAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A person who can log in to the ERP.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name              String?
  passwordHash      String
  role              String     @default("member") // "owner" or "member"
  sessions          Session[]
  assignedCustomers Customer[] // customers this teammate is responsible for
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// A logged-in session (one per browser sign-in).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
}

// A customer / party we sell to.
model Customer {
  id            String  @id @default(cuid())
  code          String? @unique // human reference, e.g. "CUST-001" (auto-assigned)
  archived      Boolean @default(false) // hidden from the main list when true
  name          String
  company       String?
  contactPerson String? // named person at the company
  email         String?
  phone         String?
  altPhone      String? // alternate phone / WhatsApp
  address       String? // billing address
  country       String?

  // Shipping / export
  shippingAddress String? // ship-to / consignee, if different from billing
  destinationPort String? // port of discharge, e.g. "New York"
  incoterms       String? // EXW, FOB, CFR, CIF, DAP, DDP

  // Tax & payment
  gstin           String? // GST number (India)
  taxId           String? // generic tax / VAT number (foreign buyers)
  currency        String  @default("INR") // default billing currency
  paymentTerms    String? // e.g. "Net 30", "Advance", "LC at sight"
  creditLimit     Float? // max outstanding allowed, in the customer's currency
  defaultDiscount Float? // standing discount %, 0-100

  // Relationship
  category      String? // Distributor, Retailer, Agent, Wholesaler, Direct
  salesperson   User?   @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  salespersonId String?

  createdByName String? // teammate who added this customer (snapshot of their name)
  notes     String?
  orders    Order[]
  prices    CustomerPrice[] // this customer's agreed prices per width-variant
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A customer's negotiated price for a specific width-variant (Product).
model CustomerPrice {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  price      Float
  currency   String   @default("INR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
}

// The managed "main product type" list, e.g. Silk Dupion, Boucle, Furnishing.
model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  hsnCode   String? // optional default HSN for designs in this type
  leadDays  Int? // typical days to make/procure this type — drives due-date warnings
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  designs   Design[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A design code / number under a product type. Carries composition & HSN.
model Design {
  id          String          @id @default(cuid())
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  code        String          @unique // the user's own design number
  name        String?
  composition String? // e.g. "100% Silk"
  hsnCode     String? // defaults from the category, editable
  leadDays    Int? // override the type's make/procure lead time for this design
  description String?
  imageData   String? // downscaled JPEG as a base64 data URL

  // Supply side — nothing is made in-house.
  sourcingType String? // "JOB_WORK" or "TRADING"
  vendor       Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId     String? // assigned kaarigar (job work) or supplier (trading)

  archived  Boolean   @default(false)
  variants  Product[] // its width-variants
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// One width-variant of a design — the actual sellable & stockable unit that
// goes on an order. (Kept named `Product` so existing OrderItem links are
// untouched.) GSM, cost, sale price and stock all vary per width.
model Product {
  id          String      @id @default(cuid())
  design      Design?     @relation(fields: [designId], references: [id])
  designId    String?
  name           String // auto-set to "<design code> · <width>[· <colour>]"
  sku            String? // optional barcode / internal code
  width          String? // e.g. 44", 58", 150 cm
  colour         String? // e.g. Gold, Silver (affects cost for hand embroidery)
  gsm            Float? // grams per square metre
  description    String?
  unit           String          @default("mtr")
  costPrice      Float? // what this width costs us
  currency       String          @default("INR")
  stockQty       Float           @default(0) // quantity on hand
  reorderLevel   Float? // low-stock threshold
  archived       Boolean         @default(false)
  orderItems     OrderItem[]
  customerPrices CustomerPrice[]
  jobItems       JobItem[]
  movements      StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// An audit log of every stock change (in or out). Reference ids are plain
// strings (no FKs) so the history survives if the order/job is later deleted.
model StockMovement {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  delta     Float // +in / -out
  reason    String // JOB_RECEIVE | ORDER_SHIP | ORDER_UNSHIP | MANUAL_ADJUST
  note      String?
  orderId   String?
  jobId     String?
  userId    String?
  createdAt DateTime @default(now())
}

// A party we buy from / give job work to: kaarigars (makers) and suppliers.
model Vendor {
  id        String   @id @default(cuid())
  code      String?  @unique // "VEND-001", auto-assigned
  name      String
  kind      String   @default("KAARIGAR") // "KAARIGAR" | "SUPPLIER" | "BOTH"
  contactPerson String? // named person at the vendor
  phone     String?
  altPhone  String? // second / WhatsApp number
  email     String?
  address   String?
  country   String?
  gstin     String? // vendor's GST number (for their invoices / input credit)
  currency  String   @default("INR") // currency you pay this vendor in
  paymentTerms String? // e.g. "Advance", "Net 15"
  leadDays  Int? // typical days this vendor takes — feeds due-date warnings
  // Bank details, for paying the vendor.
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  bankSwift       String?
  bankBranch      String?
  notes     String?
  archived  Boolean  @default(false)
  designs   Design[]
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An inbound document: a job-work order to a kaarigar, or a purchase from a
// supplier. Receiving its items brings finished goods into stock.
model Job {
  id        String    @id @default(cuid())
  number    Int       @unique // internal global job no., assigned in app code
  // Document number = per-(kind, financial year) sequence, shown as JW/25-26/001
  // or PO/25-26/001. Nullable for jobs created before this scheme.
  seq       Int?
  fyLabel   String? // Indian financial year tag, e.g. "25-26"
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  vendorId  String
  kind      String    @default("JOB_WORK") // "JOB_WORK" | "PURCHASE"
  status    String    @default("OPEN") // OPEN | PARTIAL | RECEIVED | CANCELLED
  currency  String    @default("INR") // currency of the rates paid to the vendor
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?
  // The sales order this job was auto-generated from, if any.
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  items     JobItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A line on a job: a width-variant, quantity assigned and received, and the rate
// (making charge for job work, purchase price for trading) paid to the vendor.
model JobItem {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  // Quantity is entered piece-wise like orders: pieces × perPieceQty. qtyOrdered
  // stays the computed total (source of truth for receiving, stock and value).
  pieces      Int? // number of pieces (null = loose quantity)
  perPieceQty Float? // quantity in each piece
  qtyOrdered  Float    @default(0)
  qtyReceived Float    @default(0)
  rate        Float? // making charge / purchase price per unit
  dueDate     DateTime? // this line's own due date
  note        String? // colour / spec for this line
  unit        String   @default("mtr")
  createdAt   DateTime @default(now())
}

// A sales order placed by a customer.
// `status` is one of: DRAFT, CONFIRMED, IN_PRODUCTION, SHIPPED, COMPLETED, CANCELLED
// (stored as text because SQLite has no native enum; validated in app code).
model Order {
  id         String      @id @default(cuid())
  number     Int         @unique // human-facing order no., assigned in app code
  customer   Customer    @relation(fields: [customerId], references: [id])
  customerId String
  status     String      @default("DRAFT")
  currency   String      @default("INR")
  orderDate  DateTime    @default(now())
  dueDate    DateTime? // overall target date; each line may override with its own
  notes      String?
  createdByName String? // teammate who created this order (snapshot of their name)

  // Snapshot of the customer's details at order time, frozen so a sent PDF never
  // changes if the customer is later edited. Prefilled from the customer,
  // editable per order (e.g. a different consignee for this shipment).
  billToName      String?
  billToAddress   String?
  billToTaxId     String? // GSTIN (India) or foreign tax/VAT id
  shipToName      String? // consignee, if different from bill-to
  shipToAddress   String?
  destinationPort String?
  incoterms       String? // EXW, FOB, CFR, CIF, DAP, DDP
  paymentTerms    String?

  items      OrderItem[]
  jobs       Job[] // job-work / purchase orders auto-generated from this order
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// A single line on a sales order.
model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  description String?  // e.g. colour / spec for this line
  quantity    Float    @default(0) // TOTAL metres = pieces × perPieceQty (the priced quantity)
  pieces      Int? // number of pieces / thans on this line
  perPieceQty Float? // metres in each piece; quantity is derived from this × pieces
  shippedQty  Float    @default(0) // metres shipped so far (item-wise fulfillment)
  dueDate     DateTime? // this line's own due date; falls back to the order's when null
  unit        String   @default("mtr")
  rate        Float    @default(0) // price per unit in the order currency
  createdAt   DateTime @default(now())
}
