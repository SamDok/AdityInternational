// Aditya International ERP — data model
// SQLite for local dev. For production, switch `provider` to "postgresql"
// and set DATABASE_URL to your hosted Postgres connection string.

generator client {
  provider      = "prisma-client-js"
  // "native" for local use; the rhel target is what Vercel's servers need.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The exporter's own details — a single row (id = "default") used as the
// letterhead on proforma invoices. All fields optional; the PDF shows what's set.
model CompanyProfile {
  id             String   @id @default("default")
  legalName      String?
  address        String? // multi-line billing/registered address
  gstin          String?
  country        String? // country of origin for export docs (defaults to India)
  defaultGstRate Float? // fallback GST % for domestic sales when a design has none
  phone          String?
  email          String?
  website        String?
  logoData       String? // downscaled logo as a base64 data URL
  // Footer
  signatureName  String? // "Authorised Signatory" name
  footerNote     String? // standing terms / thank-you line
  updatedAt      DateTime @updatedAt @default(now())
}

// One bank account per currency, so the proforma shows the account a buyer
// should actually pay into. INR uses IFSC; foreign accounts use SWIFT (and
// sometimes IBAN) — the PDF prints whichever fields are filled.
model BankAccount {
  id          String   @id @default(cuid())
  currency    String   @unique // USD, EUR, GBP, INR — one account each
  bankName    String?
  accountName String?
  accountNo   String?
  swift       String? // foreign-currency accounts
  ifsc        String? // INR (domestic) accounts
  iban        String? // some EUR / GBP accounts
  branch      String?
  bankAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A person who can log in to the ERP.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name              String?
  passwordHash      String
  role              String     @default("member") // "owner" or "member"
  sessions          Session[]
  assignedCustomers Customer[] // customers this teammate is responsible for
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// A logged-in session (one per browser sign-in).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
}

// A customer / party we sell to.
model Customer {
  id            String  @id @default(cuid())
  code          String? @unique // human reference, e.g. "CUST-001" (auto-assigned)
  archived      Boolean @default(false) // hidden from the main list when true
  name          String
  company       String?
  contactPerson String? // named person at the company
  email         String?
  phone         String?
  altPhone      String? // alternate phone / WhatsApp
  address       String? // billing address
  country       String?

  // Shipping / export
  shippingAddress String? // ship-to / consignee, if different from billing
  destinationPort String? // port of discharge, e.g. "New York"
  incoterms       String? // EXW, FOB, CFR, CIF, DAP, DDP

  // Tax & payment
  gstin           String? // GST number (India)
  taxId           String? // generic tax / VAT number (foreign buyers)
  currency        String  @default("INR") // default billing currency
  paymentTerms    String? // e.g. "Net 30", "Advance", "LC at sight"
  creditLimit     Float? // max outstanding allowed, in the customer's currency
  defaultDiscount Float? // standing discount %, 0-100

  // Relationship
  category      String? // Distributor, Retailer, Agent, Wholesaler, Direct
  salesperson   User?   @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  salespersonId String?

  tags          String[] @default([]) // free-form labels: "VIP", "slow payer", "sampling"
  createdByName String? // teammate who added this customer (snapshot of their name)
  updatedByName String? // teammate who last edited this customer (snapshot of their name)
  notes     String?
  orders    Order[]
  shipments Shipment[]
  payments  Payment[] // money received from this customer
  prices    CustomerPrice[] // this customer's agreed prices per width-variant
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Money received from a customer. May be an advance (no invoice) or settle a
// specific invoice (shipment). Outstanding is derived: invoiced − received.
model Payment {
  id            String    @id @default(cuid())
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  shipment      Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentId    String? // optional: receipt booked against a specific invoice
  amount        Float
  currency      String    @default("INR")
  fxRate        Float? // realization rate: INR per 1 unit of the receipt currency, for FX gain/loss
  date          DateTime  @default(now())
  method        String? // Bank / Cash / Cheque / LC / Other
  reference     String? // UTR / cheque no. / LC no.
  note          String?
  createdByName String?
  createdAt     DateTime  @default(now())
}

// Money paid to a vendor (kaarigar / supplier). May settle a specific job/PO.
model VendorPayment {
  id            String   @id @default(cuid())
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId      String
  job           Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId         String? // optional: payment booked against a specific job / PO
  materialPo    MaterialPurchaseOrder? @relation(fields: [materialPoId], references: [id], onDelete: SetNull)
  materialPoId  String? // optional: payment booked against a material purchase order
  amount        Float
  currency      String   @default("INR")
  date          DateTime @default(now())
  method        String?
  reference     String?
  note          String?
  createdByName String?
  createdAt     DateTime @default(now())
}

// A customer's negotiated price for a specific width-variant (Product).
model CustomerPrice {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  price      Float
  currency   String   @default("INR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
}

// The managed "main product type" list, e.g. Silk Dupion, Boucle, Furnishing.
model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  hsnCode   String? // optional default HSN for designs in this type
  leadDays  Int? // typical days to make/procure this type — drives due-date warnings
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  designs   Design[]
  materialDefaults CategoryMaterial[] // default materials for every design of this type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A design code / number under a product type. Carries composition & HSN.
model Design {
  id          String          @id @default(cuid())
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  code        String          @unique // the user's own design number
  name        String?
  composition String? // e.g. "100% Silk"
  hsnCode     String? // defaults from the category, editable
  gstRate     Float? // GST % for domestic sales (e.g. 5 for fabric, 12 for made-ups)
  leadDays    Int? // override the type's make/procure lead time for this design
  description String?
  // Photo lives in a separate 1:1 table (DesignImage) so the base64 bytes don't
  // bloat every design read — critical with thousands of designs. Served via the
  // /designs/[id]/image route.
  image        DesignImage?

  // Supply side — nothing is made in-house.
  sourcingType String? // "JOB_WORK" or "TRADING"
  vendor       Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId     String? // assigned kaarigar (job work) or supplier (trading)

  archived  Boolean   @default(false)
  variants  Product[] // its width-variants
  materialOverrides DesignMaterial[] // per-design default materials (override the type)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// One design's photo, kept out of the Design row (base64 is large). Loaded only
// when a thumbnail/full image is actually shown.
model DesignImage {
  designId  String   @id
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  data      String // downscaled JPEG/PNG as a base64 data URL
  updatedAt DateTime @updatedAt @default(now())
}

// One width-variant of a design — the actual sellable & stockable unit that
// goes on an order. (Kept named `Product` so existing OrderItem links are
// untouched.) GSM, cost, sale price and stock all vary per width.
model Product {
  id          String      @id @default(cuid())
  design      Design?     @relation(fields: [designId], references: [id])
  designId    String?
  name           String // auto-set to "<design code> · <width>[· <colour>]"
  sku            String? // optional barcode / internal code
  width          String? // e.g. 44", 58", 150 cm
  colour         String? // e.g. Gold, Silver (affects cost for hand embroidery)
  gsm            Float? // grams per square metre
  description    String?
  unit           String          @default("mtr")
  costPrice      Float? // what this width costs us
  currency       String          @default("INR")
  stockQty       Float           @default(0) // quantity on hand
  reorderLevel   Float? // low-stock threshold
  archived       Boolean         @default(false)
  orderItems     OrderItem[]
  customerPrices CustomerPrice[]
  jobItems       JobItem[]
  shipmentItems  ShipmentItem[]
  movements      StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// An audit log of every stock change (in or out). Reference ids are plain
// strings (no FKs) so the history survives if the order/job is later deleted.
model StockMovement {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  delta     Float // +in / -out (metres)
  pieces    Int? // pieces moved in this event
  weight    Float? // weight (kg) moved in this event
  reason    String // JOB_RECEIVE | ORDER_SHIP | ORDER_UNSHIP | MANUAL_ADJUST
  note      String?
  orderId   String?
  jobId     String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  shipmentId String?
  userId    String?
  createdAt DateTime @default(now())
}

// A party we buy from / give job work to: kaarigars (makers) and suppliers.
model Vendor {
  id        String   @id @default(cuid())
  code      String?  @unique // "VEND-001", auto-assigned
  name      String
  kind      String   @default("KAARIGAR") // "KAARIGAR" | "SUPPLIER" | "BOTH"
  contactPerson String? // named person at the vendor
  phone     String?
  altPhone  String? // second / WhatsApp number
  email     String?
  address   String?
  country   String?
  gstin     String? // vendor's GST number (for their invoices / input credit)
  currency  String   @default("INR") // currency you pay this vendor in
  paymentTerms String? // e.g. "Advance", "Net 15"
  leadDays  Int? // typical days this vendor takes — feeds due-date warnings
  // Bank details, for paying the vendor.
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  bankSwift       String?
  bankBranch      String?
  notes     String?
  archived  Boolean  @default(false)
  designs   Design[]
  jobs      Job[]
  payments  VendorPayment[]
  materialsSupplied RawMaterial[]        // materials this supplier provides
  materialPos       MaterialPurchaseOrder[] // material POs raised to this supplier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An inbound document: a job-work order to a kaarigar, or a purchase from a
// supplier. Receiving its items brings finished goods into stock.
model Job {
  id        String    @id @default(cuid())
  number    Int       @unique // internal global job no., assigned in app code
  // Document number = per-(kind, financial year) sequence, shown as JW/25-26/001
  // or PO/25-26/001. Nullable for jobs created before this scheme.
  seq       Int?
  fyLabel   String? // Indian financial year tag, e.g. "25-26"
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  vendorId  String
  kind      String    @default("JOB_WORK") // "JOB_WORK" | "PURCHASE"
  status    String    @default("OPEN") // OPEN | PARTIAL | RECEIVED | CANCELLED
  currency  String    @default("INR") // currency of the rates paid to the vendor
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?
  // The sales order this job was auto-generated from, if any.
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  // Multi-process production: a job can be one stage of a route (embroidery →
  // wash → finishing), each stage a job to its own kaarigar. An intermediate
  // stage's output is work-in-progress (not sellable stock); only the final
  // stage's receipt lands in finished stock. routeId groups a route's stages.
  routeId      String? // shared across a route's stages (the first stage's id)
  stageNo      Int? // 1-based position in the route (null = a plain single job)
  stageName    String? // e.g. "Embroidery", "Wash", "Finishing"
  prevStage    Job?    @relation("JobStages", fields: [prevStageId], references: [id], onDelete: SetNull)
  prevStageId  String?
  nextStages   Job[]   @relation("JobStages")
  isFinalStage Boolean @default(true) // false = output is WIP handed to the next stage

  items     JobItem[]
  payments  VendorPayment[] // payments booked against this job / PO
  materials JobMaterial[]   // raw materials issued to the kaarigar for this job
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A line on a job: a width-variant, quantity assigned and received, and the rate
// (making charge for job work, purchase price for trading) paid to the vendor.
model JobItem {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  // Quantity is entered piece-wise like orders: pieces × perPieceQty. qtyOrdered
  // stays the computed total (source of truth for receiving, stock and value).
  pieces      Int? // number of pieces (null = loose quantity)
  perPieceQty Float? // quantity in each piece
  qtyOrdered  Float    @default(0)
  qtyReceived Float    @default(0) // actual measured total received (metres) — may differ from pieces × perPieceQty
  piecesReceived Int   @default(0) // count of pieces received (drives completion for piece-wise lines)
  weightReceived Float @default(0) // cumulative weight (kg) received
  rate        Float? // making charge / purchase price per unit
  dueDate     DateTime? // this line's own due date
  note        String? // colour / spec for this line
  unit        String   @default("mtr")
  materials   JobMaterial[] // raw materials issued for this specific design line
  createdAt   DateTime @default(now())
}

// A sales order placed by a customer.
// `status` is one of: DRAFT, CONFIRMED, IN_PRODUCTION, SHIPPED, COMPLETED, CANCELLED
// (stored as text because SQLite has no native enum; validated in app code).
model Order {
  id         String      @id @default(cuid())
  number     Int         @unique // human-facing order no., assigned in app code
  customer   Customer    @relation(fields: [customerId], references: [id])
  customerId String
  status     String      @default("DRAFT")
  currency   String      @default("INR")
  orderDate  DateTime    @default(now())
  dueDate    DateTime? // overall target date; each line may override with its own
  notes      String?
  createdByName String? // teammate who created this order (snapshot of their name)
  // Manually closed as complete even if measured metres fall a little short of the
  // order (e.g. all pieces shipped). Completion is otherwise per-line & automatic.
  manualComplete Boolean @default(false)

  // Reference exchange rates ({ USD: 83.5, ... }) frozen at order creation, so the
  // estimated export margin is locked to the rate on the order date and does not
  // drift when the daily rate refresh runs. Null on orders created before this.
  fxRates    Json?

  // Snapshot of the customer's details at order time, frozen so a sent PDF never
  // changes if the customer is later edited. Prefilled from the customer,
  // editable per order (e.g. a different consignee for this shipment).
  billToName      String?
  billToAddress   String?
  billToTaxId     String? // GSTIN (India) or foreign tax/VAT id
  shipToName      String? // consignee, if different from bill-to
  shipToAddress   String?
  destinationPort String?
  incoterms       String? // EXW, FOB, CFR, CIF, DAP, DDP
  paymentTerms    String?
  discountPct     Float? // header discount %, prefilled from the customer's standing discount

  // Sampling: a sample order is made specially and kept out of the sales /
  // margin / order-book figures. It can still carry a price (charged samples
  // show in receivables). sampleStatus tracks approval; sampleSource links a
  // bulk order back to the sample it was converted from.
  // Document numbering: AI/25-26/001 (production) or AI/S/25-26/001 (sample),
  // each a per-financial-year series. `number` stays a global counter for
  // internal uniqueness; seq + fyLabel drive the human-facing code.
  seq          Int? // per-(isSample, financial year) document sequence
  fyLabel      String? // Indian financial year tag, e.g. "25-26"
  isSample     Boolean @default(false)
  sampleNo     Int? // legacy sample running number; superseded by seq + fyLabel
  sampleStatus String? // PENDING | APPROVED | REJECTED (samples only)
  sampleSource   Order?  @relation("SampleToBulk", fields: [sampleSourceId], references: [id], onDelete: SetNull)
  sampleSourceId String?
  bulkOrders     Order[] @relation("SampleToBulk") // bulk orders spawned from this sample

  items      OrderItem[]
  jobs       Job[] // job-work / purchase orders auto-generated from this order
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// A physical dispatch to one customer. Can club ready items from several of that
// customer's orders. Produces a commercial invoice + packing list.
model Shipment {
  id         String  @id @default(cuid())
  number     Int     @unique // internal counter
  seq        Int? // per financial-year document sequence → INV/25-26/001, PL/25-26/001
  fyLabel    String?
  date       DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  currency   String   @default("INR")
  status     String   @default("DISPATCHED") // DISPATCHED | CANCELLED
  isSample   Boolean  @default(false) // a sample dispatch (inherited from the order); kept out of sales figures

  // Snapshot of parties/terms for the documents (frozen at ship time).
  billToName      String?
  billToAddress   String?
  billToTaxId     String?
  shipToName      String?
  shipToAddress   String?
  destinationPort String?
  destinationCountry String? // country of final destination for export docs
  incoterms       String?
  paymentTerms    String?

  // Pricing adjustments on the invoice.
  discountPct   Float? // header discount %, applied before GST
  freight       Float? // freight added after tax (FOB → C&F/CIF)
  insurance     Float? // insurance added after tax (→ CIF)
  otherCharges  Float? // any other charge added after tax
  fxRate        Float? // INR per 1 unit of the invoice currency, for accounting

  // Export / logistics detail (mostly for the documents; some issued post-dispatch).
  marksNumbers   String? // shipping marks & numbers
  grossWeight    Float? // total gross weight (kg, incl. packing)
  portOfLoading  String?
  vessel         String? // vessel / flight
  blAwbNo        String? // Bill of Lading or Air Waybill number
  containerNo    String?
  shippingBillNo String? // export shipping bill / LEO number
  eInvoiceIrn    String? // e-invoice IRN
  ewayBillNo     String? // e-way bill number
  notes          String?
  createdByName  String?

  items     ShipmentItem[]
  movements StockMovement[]
  payments  Payment[] // receipts booked against this invoice
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String
  // The order line this fulfils — gives us the order, product and rate.
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  description String?
  unit        String   @default("mtr")
  pieces      Int? // pieces shipped in this consignment
  quantity    Float    @default(0) // metres shipped
  netWeight   Float    @default(0) // net weight of the goods (kg)
  cartons     Int? // cartons / bales for this line
  rate        Float    @default(0) // snapshot of the order-line rate, for the invoice
  createdAt   DateTime @default(now())
}

// A single line on a sales order.
model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  description String?  // e.g. colour / spec for this line
  quantity    Float    @default(0) // TOTAL metres = pieces × perPieceQty (the priced quantity)
  pieces      Int? // number of pieces / thans on this line
  perPieceQty Float? // metres in each piece; quantity is derived from this × pieces
  shippedQty  Float    @default(0) // metres shipped so far (item-wise fulfillment)
  shippedWeight Float  @default(0) // cumulative weight (kg) shipped, captured for packing/invoice
  dueDate     DateTime? // this line's own due date; falls back to the order's when null
  unit        String   @default("mtr")
  rate        Float    @default(0) // price per unit in the order currency
  shipmentItems ShipmentItem[]
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Raw materials: base fabrics + embellishments issued to kaarigars for job work.
// Bought from suppliers via material purchase orders; issued per design line.
// ---------------------------------------------------------------------------

// A stockable input item — base fabric (e.g. Silver Georgette), zari, beads,
// sequins, thread. Not a finished Design; lives in its own inventory.
model RawMaterial {
  id           String   @id @default(cuid())
  code         String?  @unique // "RM-001", auto-assigned
  name         String
  kind         String   @default("BASE_FABRIC") // BASE_FABRIC | EMBELLISHMENT | THREAD | OTHER
  unit         String   @default("mtr") // mtr for fabric, kg / g / pcs / cone for others
  stockQty     Float    @default(0)
  costPrice    Float? // last known cost per unit
  currency     String   @default("INR")
  reorderLevel Float? // low-stock threshold
  hsnCode      String?
  supplier     Vendor?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId   String? // default supplier we buy this from
  notes        String?
  archived     Boolean  @default(false)
  movements    RawMaterialMovement[]
  poItems      MaterialPOItem[]
  issues       JobMaterial[]
  categoryDefaults CategoryMaterial[]
  designDefaults   DesignMaterial[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// An audit log of every raw-material stock change. Reference ids are plain
// strings where the source may later be deleted (mirrors StockMovement).
model RawMaterialMovement {
  id         String      @id @default(cuid())
  material   RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String
  delta      Float // + in / - out
  reason     String // PURCHASE | ISSUE_TO_JOB | RETURN_FROM_JOB | MANUAL_ADJUST
  note       String?
  jobId      String?
  materialPoId String?
  userId     String?
  createdAt  DateTime @default(now())
}

// A purchase order for raw materials, raised to a supplier. Receiving its items
// brings materials into stock. Mirrors Job for finished goods.
model MaterialPurchaseOrder {
  id        String   @id @default(cuid())
  number    Int      @unique // internal global no., assigned in app code
  seq       Int? // per-financial-year document sequence -> MPO/25-26/001
  fyLabel   String?
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  vendorId  String
  status    String   @default("OPEN") // OPEN | PARTIAL | RECEIVED | CANCELLED
  currency  String   @default("INR")
  issueDate DateTime @default(now())
  dueDate   DateTime?
  notes     String?
  items     MaterialPOItem[]
  payments  VendorPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialPOItem {
  id          String   @id @default(cuid())
  po          MaterialPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId        String
  material    RawMaterial @relation(fields: [materialId], references: [id])
  materialId  String
  qtyOrdered  Float    @default(0)
  qtyReceived Float    @default(0)
  rate        Float? // purchase price per unit
  unit        String   @default("mtr")
  note        String?
  createdAt   DateTime @default(now())
}

// Materials handed to a kaarigar for one design line of a job. Reconciliation:
// used = qtyIssued - qtyReturned.
model JobMaterial {
  id          String   @id @default(cuid())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  jobItem     JobItem  @relation(fields: [jobItemId], references: [id], onDelete: Cascade)
  jobItemId   String // the design line these materials are for
  material    RawMaterial @relation(fields: [materialId], references: [id])
  materialId  String
  qtyIssued   Float    @default(0)
  qtyReturned Float    @default(0)
  unit        String   @default("mtr")
  note        String?
  createdAt   DateTime @default(now())
}

// Default materials for every design of a fabric type (set once per type).
model CategoryMaterial {
  id          String   @id @default(cuid())
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  material    RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId  String
  qtyPerPiece Float? // optional suggested quantity per piece
  note        String?

  @@unique([categoryId, materialId])
}

// Optional per-design override / addition to the type's default materials.
model DesignMaterial {
  id          String   @id @default(cuid())
  design      Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  designId    String
  material    RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId  String
  qtyPerPiece Float?
  note        String?

  @@unique([designId, materialId])
}

// Reference exchange rates so export orders (foreign sale, INR cost) can show an
// estimated margin before a shipment's actual FX rate is set. One row per
// foreign currency; value = INR per 1 unit (e.g. USD -> 83.5).
model FxRate {
  currency   String   @id // USD, EUR, GBP, AED
  perUnitInr Float // INR per 1 unit of this currency
  updatedAt  DateTime @updatedAt @default(now())
}
